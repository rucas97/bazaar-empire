<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_window"
    android:padding="40dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_inner"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تنظیمات"
            android:textColor="#F4C430"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:gravity="center" />

        <CheckBox
            android:id="@+id/cbMusic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="موسیقی (Music)"
            android:textColor="#F5E6D3"
            android:textSize="16sp"
            android:buttonTint="#30B5A5" />

        <CheckBox
            android:id="@+id/cbSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="افکت صوتی (Sound)"
            android:textColor="#F5E6D3"
            android:textSize="16sp"
            android:buttonTint="#30B5A5" />

        <!-- NEW VOLUME BAR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="میزان صدا (Volume)"
            android:textColor="#F5E6D3"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekBarVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progressTint="#30B5A5"
            android:thumbTint="#F4C430"
            android:max="100" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"
            android:backgroundTint="#30B5A5"
            android:text="ذخیره"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
