<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_window"
    android:paddingStart="35dp"
    android:paddingEnd="35dp"
    android:paddingTop="45dp"
    android:paddingBottom="35dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Title"
        android:textColor="#F4C430"
        android:textSize="22sp"
        android:textStyle="bold"
        android:shadowColor="#000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxHeight="200dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDialogTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message goes here"
            android:textColor="#F5E6D3"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center" />
    </ScrollView>

    <Button
        android:id="@+id/btnDialogPositive"
        android:layout_width="110dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#30B5A5"
        android:text="OK"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/scrollViewMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnDialogNegative" />

    <Button
        android:id="@+id/btnDialogNegative"
        android:layout_width="110dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#C1653A"
        android:text="Cancel"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" 
        app:layout_constraintTop_toBottomOf="@+id/scrollViewMessage"
        app:layout_constraintStart_toEndOf="@+id/btnDialogPositive"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
