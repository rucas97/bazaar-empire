<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="500dp"
    android:background="@drawable/panel_window"
    android:padding="40dp">

    <TextView
        android:id="@+id/tvShopTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="فروشگاه"
        android:textColor="#F4C430"
        android:textSize="24sp"
        android:textStyle="bold"
        android:shadowColor="#000"
        android:shadowDx="2"
        android:shadowDy="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable Area for Items -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/tvShopTitle"
        app:layout_constraintBottom_toTopOf="@+id/btnCloseShop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Placeholder Item 1 -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#1A4A4A"
                android:text="آواتار ۱ - ۵۰۰ سکه"
                android:textColor="#F5E6D3" />

            <!-- Placeholder Item 2 -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#1A4A4A"
                android:text="آواتار ۲ - ۱۰۰۰ سکه"
                android:textColor="#F5E6D3" />
                
            <!-- Placeholder Item 3 -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#1A4A4A"
                android:text="آواتار ۳ - ۲۰۰۰ سکه"
                android:textColor="#F5E6D3" />
                
             <!-- Placeholder Item 4 -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#1A4A4A"
                android:text="آواتار ۴ - ۵۰۰۰ سکه"
                android:textColor="#F5E6D3" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnCloseShop"
        android:layout_width="120dp"
        android:layout_height="50dp"
        android:backgroundTint="#30B5A5"
        android:text="بستن"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
