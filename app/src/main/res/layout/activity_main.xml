<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A4A4A">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_bazaar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TOP LEFT: AVATAR -->
    <FrameLayout
        android:id="@+id/avatarFrame"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_shop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgPlayerAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="14dp"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_default" />
    </FrameLayout>

    <!-- TOP RIGHT: SCOREBOARD (Stretched to fill remaining space) -->
    <ImageView
        android:id="@+id/scorePanel"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:scaleType="fitXY" 
        android:src="@drawable/panel_score"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatarFrame"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HUGE COIN TEXT -->
    <TextView
        android:id="@+id/tvCoinCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="۰"
        android:textColor="#F5E6D3"
        android:textSize="34sp"
        android:textStyle="bold"
        android:shadowColor="#000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@+id/scorePanel"
        app:layout_constraintBottom_toBottomOf="@+id/scorePanel"
        app:layout_constraintStart_toStartOf="@+id/scorePanel"
        app:layout_constraintEnd_toEndOf="@+id/scorePanel" />

    <!-- BOTTOM LEFT: HUGE AD BUTTON -->
    <ImageButton
        android:id="@+id/btnAd"
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:scaleType="fitXY"
        android:src="@drawable/btn_ad"
        app:layout_constraintTop_toBottomOf="@+id/avatarFrame"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تبلیغات"
        android:textColor="#F5E6D3"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="45dp" 
        app:layout_constraintTop_toTopOf="@+id/btnAd"
        app:layout_constraintBottom_toBottomOf="@+id/btnAd"
        app:layout_constraintStart_toStartOf="@+id/btnAd"
        app:layout_constraintEnd_toEndOf="@+id/btnAd" />

    <!-- BOTTOM RIGHT: HUGE TIMER -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="130dp"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_timer"
        android:gravity="center"
        android:text="۰۰:۰۰"
        android:textColor="#F4C430"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/scorePanel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GAME ELEMENTS -->
    <ImageView
        android:id="@+id/itemImage"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="16dp"
        android:adjustViewBounds="true"
        android:src="@drawable/item_tea"
        app:layout_constraintBottom_toTopOf="@+id/btnTap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivSparkle"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/coin"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/itemImage"
        app:layout_constraintEnd_toEndOf="@+id/itemImage"
        app:layout_constraintStart_toStartOf="@+id/itemImage"
        app:layout_constraintTop_toTopOf="@+id/itemImage" />

    <ImageButton
        android:id="@+id/btnTap"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="24dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_tap"
        app:layout_constraintBottom_toTopOf="@+id/btnUpgrade"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnUpgrade"
        android:layout_width="320dp"
        android:layout_height="85dp"
        android:layout_marginBottom="24dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_upgrade"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvUpgradeCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ارتقا: ۳۰"
        android:textColor="#F5E6D3"
        android:textSize="18sp"
        android:textStyle="bold"
        android:shadowColor="#000"
        android:shadowDx="1"
        android:shadowDy="1"
        app:layout_constraintTop_toTopOf="@+id/btnUpgrade"
        app:layout_constraintBottom_toTopOf="@+id/btnUpgrade"
        app:layout_constraintStart_toStartOf="@+id/btnUpgrade"
        app:layout_constraintEnd_toEndOf="@+id/btnUpgrade" />

    <ImageButton
        android:id="@+id/btnGoldenDeal"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/coin"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnBadCoin"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/coin_bad"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
