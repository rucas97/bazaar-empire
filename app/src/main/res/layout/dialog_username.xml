<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_window"
    android:padding="40dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_inner"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="خوش آمدید!"
            android:textColor="#F4C430"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="لطفا نام خود را وارد کنید:"
            android:textColor="#F5E6D3"
            android:textSize="16sp"
            android:gravity="center" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="#1A4A4A"
            android:paddingHorizontal="12dp"
            android:hint="نام شما..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="textPersonName" />

        <Button
            android:id="@+id/btnConfirmName"
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"
            android:backgroundTint="#30B5A5"
            android:text="تایید"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
